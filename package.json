{
  "name": "@sistema32/santacorina-ui",
  "version": "0.21.0",
  "description": "Tokens de marca y componentes compartidos (plugin de Tailwind CSS v4) para los sistemas del Servicio Local de Educacion Publica Santa Corina.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.mjs",
      "require": "./dist/theme.cjs"
    },
    "./css": "./dist/ui.css",
    "./js": {
      "types": "./dist/js.d.ts",
      "import": "./dist/js.mjs",
      "require": "./dist/js.cjs"
    },
    "./js/global": "./dist/js.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "check": "node scripts/autocheck.mjs",
    "dev:guia": "node scripts/build-css.mjs && npx serve . -l 4321"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "tailwindcss": "^4.1.16",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sistema32/santacorina-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
